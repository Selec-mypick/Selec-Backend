services:
  mysql:
    image: mysql:8.0
    container_name: selec-mysql
    restart: always
    ports:
      - "3306:3306"
    environment:
      MYSQL_ROOT_PASSWORD: "selec1!"
      MYSQL_DATABASE: selec
      MYSQL_USER: selec
      MYSQL_PASSWORD: "selec1!"
      TZ: Asia/Seoul
    command:
      - --character-set-server=utf8mb4
      - --collation-server=utf8mb4_unicode_ci
      - --default-time-zone=+09:00
    volumes:
      - mysql_data:/var/lib/mysql
    networks:
      - selec-network

  redis:
    image: redis:7.2
    container_name: selec-redis
    restart: always
    ports:
      - "6379:6379"
    command: redis-server /usr/local/etc/redis/redis.conf
    volumes:
      - ./redis/redis.conf:/usr/local/etc/redis/redis.conf
      - redis_data:/data
    networks:
      - selec-network

  loki:
    image: grafana/loki:latest
    container_name: selec-loki
    restart: always
    command: -config.file=/etc/loki/local-config.yaml
    networks:
      - selec-network

  promtail:
    image: grafana/promtail:latest
    container_name: selec-promtail
    restart: always
    volumes:
      - /var/lib/docker/containers:/var/lib/docker/containers:ro
      - /var/run/docker.sock:/var/run/docker.sock
      - ./promtail/promtail.yml:/etc/promtail/config.yml
    command: -config.file=/etc/promtail/config.yml
    depends_on:
      - loki
    networks:
      - selec-network

  grafana:
    image: grafana/grafana:latest
    container_name: selec-grafana
    restart: always
    ports:
      - "127.0.0.1:3000:3000"
    environment:
      - GF_SERVER_ROOT_URL=https://selec.duckdns.org/grafana/
      - GF_SERVER_SERVE_FROM_SUB_PATH=true
    volumes:
      - grafana_data:/var/lib/grafana
    depends_on:
      - loki
    networks:
      - selec-network

volumes:
  mysql_data:
  redis_data:
  grafana_data:

networks:
  selec-network:
    driver: bridge